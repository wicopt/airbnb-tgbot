generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model payments {
  id           Int   @id @default(autoincrement())
  payment_date DateTime @db.Date
  room_number  String   @db.VarChar(10)
  amount       Decimal  @db.Decimal(10, 2)
}
